# Copy to .env (git-ignored). Every key is optional: without keys the app uses the text layer only,
# or replays saved replies with TABULA_DEMO=1.

# Second reader (reads the page image to cross-check the text layer)
TYPELLM_API_KEY=            # https://typellm.ai  (default reader when set)
SCALEDOWN_API_KEY=          # https://scaledown.ai (fallback reader)
SQWISH_API_KEY=             # https://sqwish.ai   (optional row-type classifier)
# TABULA_READER=typellm     # typellm | scaledown | vlm | none (text layer only)
# TABULA_AMOS=1             # Amos cell checks (no key; sends page images to amos.scira.ai)

# Self-hosted VLM (OpenAI-compatible, e.g. `vllm serve Qwen/Qwen3-VL-8B-Instruct`)
# TABULA_VLM_URL=http://gpu-host:8000/v1
# TABULA_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# TABULA_VLM_KEY=

# Behaviour
# TABULA_DEMO=1             # replay saved replies for the eval pages: no keys, no network
# TABULA_CROSSCHECK=all     # all | needed (call the reader only when the text layer can't vouch for a page)
# TABULA_FALLBACK=1         # 0: don't try other readers when the chosen one fails
# TABULA_READER_CONCURRENCY=4
# TABULA_CACHE=runs/cache   # reply cache, keyed by page-image hash
# TABULA_STORE=runs/store   # uploaded PDFs and parse results (server)
# TABULA_CORS_ORIGINS=http://localhost:5173
# TABULA_ALLOW_CLIENT_ENDPOINTS=1  # 0 on a shared server: reject VLM URLs sent by users (the server would call them)
